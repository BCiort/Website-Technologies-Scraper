[
  {
    "name": "Shopify",
    "category": "Ecommerce",
    "rules": {
      "headers": {
        "X-ShopId": ".*",
        "X-Shopify-Stage": ".*"
      },
      "html": [
        "cdn\\.shopify\\.com",
        "var Shopify ="
      ]
    }
  },
  {
    "name": "WordPress",
    "category": "CMS",
    "rules": {
      "headers": {
        "Link": ".*api\\.w\\.org.*"
      },
      "html": [
        "wp-includes/",
        "wp-content/",
        "s\\.w\\.org",
        "wp-emoji-release"
      ]
    }
  },
  {
    "name": "React",
    "category": "Frontend Framework",
    "rules": {
      "html": [
        "data-reactroot",
        "id=\"__next\"",
        "_next/static/",
        "__NEXT_DATA__"
      ]
    }
  }
]